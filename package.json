{
  "name": "decilabel",
  "version": "1.0.0",
  "description": "Automatically add evidence-supported GitHub labels with Jev or Microsoft Decision 1",
  "license": "MIT",
  "private": false,
  "type": "module",
  "scripts": {
    "build": "ncc build dist-entry.ts -o dist --license licenses.txt",
    "build:calibration": "tsc --outDir lib",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@vercel/ncc": "^0.38.3",
    "eslint": "^10.12.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
